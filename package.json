{
  "name": "odoobar",
  "productName": "OdooBar",
  "version": "0.2.0",
  "description": "Odoo apps in the macOS menu bar",
  "author": "B42 Labs",
  "license": "BUSL-1.1",
  "private": true,
  "main": "out/src/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf out && tsc && mkdir -p out/src/renderer && cp src/renderer/*.html out/src/renderer/ && node out/scripts/render-icons.js",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test --test-concurrency=1 \"out/test/unit/*.test.js\" \"out/test/smoke/*.test.js\"",
    "dist": "npm run build && electron-builder --mac --publish never",
    "test:dist": "npm run build && node --test \"out/test/dist/*.test.js\""
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.19.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "lucide-static": "1.52.0",
    "typescript": "7.0.2"
  }
}
